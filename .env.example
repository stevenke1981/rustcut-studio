RUSTCUT_DATA_DIR=./data
RUSTCUT_BIND=127.0.0.1:8787
RUSTCUT_FFMPEG=ffmpeg
RUSTCUT_FFPROBE=ffprobe
RUST_LOG=rustcut=info,tower_http=info

# Optional: OpenAI-compatible planning endpoint
RUSTCUT_LLM_BASE_URL=https://api.example.com/v1
RUSTCUT_LLM_API_KEY=
RUSTCUT_LLM_MODEL=

# Optional: Whisper-compatible transcription endpoint
RUSTCUT_TRANSCRIBE_BASE_URL=https://api.example.com/v1
RUSTCUT_TRANSCRIBE_API_KEY=
RUSTCUT_TRANSCRIBE_MODEL=whisper-1
