[Unit]
Description=RustCut Studio video editing server
After=network.target

[Service]
Type=simple
User=rustcut
Group=rustcut
WorkingDirectory=/opt/rustcut
EnvironmentFile=/etc/rustcut/rustcut.env
ExecStart=/opt/rustcut/bin/rustcut-server --bind 127.0.0.1:8787 --data-dir /var/lib/rustcut
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustcut

[Install]
WantedBy=multi-user.target
